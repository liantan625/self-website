# Copy to .env on the Tencent VM and edit before starting.

# Public URL served by Nginx and Let's Encrypt.
WEBUI_URL=https://ai.tanlian.dev

# Ollama runs on the desktop and is reached over Tailscale.
OLLAMA_BASE_URL=http://100.95.137.108:11434

# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=change-me-generate-a-long-random-secret

# First boot option:
# - Set ENABLE_SIGNUP=true only long enough to create the first admin in the UI.
# - After the admin exists, set ENABLE_SIGNUP=false and restart the container.
# Alternative:
# - Set WEBUI_ADMIN_EMAIL and WEBUI_ADMIN_PASSWORD below for headless bootstrap.
ENABLE_SIGNUP=false

# Optional headless bootstrap. Do not commit real credentials.
# WEBUI_ADMIN_EMAIL=admin@tanlian.dev
# WEBUI_ADMIN_PASSWORD=change-me-before-first-boot
# WEBUI_ADMIN_NAME=Admin

